{
  "name": "@shuind/dsh-codex-connect",
  "displayName": "Codex Connect",
  "description": "ChatGPT OAuth and Codex models for DeepSeek Harness.",
  "version": "0.2.1",
  "author": "shuind",
  "contributors": [
    "Frank Song (original dsh-codex-connect author)",
    "Yan-Zero (original dsh-codex author)"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "openai-codex",
    "chatgpt-oauth",
    "oauth",
    "codex"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shuind/dsh-codex-connect.git"
  },
  "homepage": "https://github.com/shuind/dsh-codex-connect#readme",
  "bugs": {
    "url": "https://github.com/shuind/dsh-codex-connect/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.2-rc.1 <=0.2.2-rc.5"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "dsh-codex-connect": "lib/bin.js"
  },
  "scripts": {
    "lint": "pnpm run lint:metadata && pnpm run lint:architecture && pnpm run lint:source",
    "lint:metadata": "node scripts/lint.mjs",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:source": "eslint src --max-warnings=0 && node scripts/check-source-lint.mjs",
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "pack:check": "node scripts/lib/check-pack-command.test.mjs && node scripts/lib/check-pack-inventory.test.mjs && node scripts/check-pack.mjs",
    "check:isolated-import": "node scripts/check-isolated-import.mjs",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:isolated-import && pnpm run pack:check",
    "prepare": "npm run build",
    "prepublishOnly": "pnpm --config.minimum-release-age=0 run check"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "docs",
    "INSTALL.md",
    "VERSIONING.md",
    "MIGRATION.md",
    "NOTICE"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0",
    "@earendil-works/pi-ai": "^1.5.0"
  },
  "license": "Apache-2.0",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-session-controller",
